{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "telegram-paywall-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // The D1 database created in the Cloudflare dashboard (Storage & Databases →
  // D1 SQL Database). The ID is not a secret. To move to a different database,
  // replace the ID. The Worker creates its own tables the first time it runs,
  // so there is no migration step.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "telegram-paywall-bot",
      "database_id": "8d5bbdd2-a97d-40e8-a448-1d061a19f54c"
    }
  ],

  // Sign-in records for the MCP server (OAuth clients, grants and tokens, all
  // stored hashed or encrypted). Created automatically on the first deploy.
  "kv_namespaces": [
    { "binding": "OAUTH_KV" }
  ],

  // Runs every minute: expires monthly subscriptions, ends free trials,
  // and delivers queued /broadcast messages.
  "triggers": { "crons": ["* * * * *"] },

  // Settings and secrets are managed in the Cloudflare dashboard
  // (Worker → Settings → Variables and Secrets). keep_vars stops a deploy
  // from wiping anything you set there. See README.md for the full list.
  "keep_vars": true,

  // Logs are on. Traces are deliberately off: Telegram puts the bot token in
  // the request URL, and traces record the URL of every outbound request.
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": false }
  }
}
